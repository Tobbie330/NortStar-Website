# Home Hub secrets — copy to .env and fill in. NEVER commit .env to git.

# --- Dashboard login -------------------------------------------------------
# The single household password for the web dashboard. Leave empty to disable
# auth (only OK on a trusted LAN).
HUB_PASSWORD=change-me

# --- Wyze (also used for Roku-rebranded Wyze cams you reflash) --------------
# Create the API key at https://developer-api-console.wyze.com/#/apikey/view
WYZE_EMAIL=
WYZE_PASSWORD=
WYZE_KEY_ID=
WYZE_API_KEY=
# How the BROWSER reaches the wyze-bridge container (your server's LAN IP):
# WYZE_BRIDGE_URL=http://192.168.1.50:8101

# --- La Crosse View ---------------------------------------------------------
# The same email/password you use in the La Crosse View phone app.
LACROSSE_EMAIL=
LACROSSE_PASSWORD=

# --- Hubspace ---------------------------------------------------------------
# The same email/password you use in the Hubspace phone app.
HUBSPACE_EMAIL=
HUBSPACE_PASSWORD=
